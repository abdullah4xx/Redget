class ThemeToggle(QAbstractButton):
    def __init__(self):
        super().__init__()
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setSizePolicy(QSizePolicy.Policy.Fixed, QSizePolicy.Policy.Fixed)
        self.setFixedSize(px(54), px(32) + 3)
        self.setToolTip("Light / dark")

    def paintEvent(self, _e):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        r = QRectF(0.5, 0.5, self.width() - 1, self.height() - 3.5)
        draw_shadow(p, r, r.height() / 2)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(C("pill"))
        p.drawRoundedRect(r, r.height() / 2, r.height() / 2)
        light = STYLE["theme"] == "light"
        inset = px(3)
        kw = r.width() / 2 - inset
        kx = r.left() + inset if light else r.right() - inset - kw
        kr = QRectF(kx, r.top() + inset, kw, r.height() - 2 * inset)
        p.setBrush(red_gradient(kr))
        p.drawRoundedRect(kr, kr.height() / 2, kr.height() / 2)
        s = px(13)
        lr = QRectF(r.left() + inset + (kw - s) / 2, r.center().y() - s / 2, s, s)
        rr = QRectF(r.right() - inset - kw + (kw - s) / 2, r.center().y() - s / 2, s, s)
        paint_icon(p, "sun", lr, QColor("#fff") if light else C("sub"))
        paint_icon(p, "moon", rr, C("sub") if light else QColor("#fff"))


