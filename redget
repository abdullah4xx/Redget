def make_check_png():
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        pm = QPixmap(48, 48)
        pm.fill(Qt.GlobalColor.transparent)
        p = QPainter(pm)
        paint_icon(p, "check", QRectF(6, 6, 36, 36), QColor("#ffffff"))
        p.end()
        pm.save(os.path.join(CACHE_DIR, "check.png"), "PNG")
    except Exception as e:
        log_error("check.png: " + repr(e))


def mk_label(text, size=12, weight=QFont.Weight.Normal, role=None, align=None, wrap=False):
    l = QLabel(text)
    l.setFont(mkfont(size, weight))
    if role:
        l.setProperty("role", role)
    if align is not None:
        l.setAlignment(align)
    l.setWordWrap(wrap)
    return l


# ---------------------------------------------------------------- main window
class Main(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("RedGet")
        self.setWindowIcon(QIcon.fromTheme("redget"))
        self.settings = QSettings("redget", "redget")
        self.jobs = []
        self.current = None
        self.history = load_history()
        theme = str(self.settings.value("theme", "light"))
        STYLE["theme"] = theme if theme in THEMES else "light"
        acc = str(self.settings.value("accent", DEFAULT_ACCENT))
        STYLE["accent"] = acc if QColor(acc).isValid() else DEFAULT_ACCENT
        self.dir = str(self.settings.value("dir", DEFAULT_DIR) or DEFAULT_DIR)
        self.last_clip = ""
        self.clip_seen = ""
        self.probe_proc = None
        self.q_items = []
        self.q_idx = 0
        self.thumb_pix = None
        self.engine_version = ""
        self.notice_mode = "tip"
        self.nam = QNetworkAccessManager(self)
        self.engine = Engine(self.nam)
        self.engine.status.connect(self.on_engine_status)
        self.engine.finished.connect(self.on_engine_done)
        self.updater = SelfUpdater(self.nam)
        self.updater.state.connect(self.on_update_state)
        self.update_ready = ""

        self.bgw = Panel()
        self.setCentralWidget(self.bgw)
        self.frame = self.bgw
        self.flay = QVBoxLayout(self.bgw)
        self.flay.setSpacing(0)
        self.flay.setContentsMargins(px(10), px(11), px(10), px(10))
        self.flay.addLayout(self.build_nav())
        self.stack = QStackedWidget()
        self.stack.addWidget(self.build_download_page())
        self.stack.addWidget(self.build_history_page())
        self.stack.addWidget(self.build_settings_page())
        self.flay.addWidget(self.stack, 1)
        self.flay.addLayout(self.build_bottom())
        self.phone = PhoneOverlay(self.frame)
        self.refresh_history()
        self.set_quality_items([])
        self.apply_theme()
        self.show_page(0)

        self.clip = QGuiApplication.clipboard()
        self.clip.dataChanged.connect(self.check_clipboard)
        QGuiApplication.instance().applicationStateChanged.connect(self.on_app_state)
        QTimer.singleShot(600, self.check_clipboard)
        QTimer.singleShot(200, self.refresh_engine_state)
        QTimer.singleShot(4000, self.mark_healthy)
        QTimer.singleShot(8000, self.auto_check_update)
        self.upd_timer = QTimer(self)
        self.upd_timer.setInterval(6 * 3600 * 1000)
        self.upd_timer.timeout.connect(self.auto_check_update)
        self.upd_timer.start()
        if has_local_engine():
            try:
                if time.time() - os.path.getmtime(LOCAL_YTDLP) > 7 * 86400:
                    QTimer.singleShot(4000, self.engine.run)
            except Exception:
                pass

    # ---------- window geometry
    def place_overlay(self):
        try:
            pt = self.app_pill.mapTo(self.frame, QPoint(0, 0))
            self.phone.move(pt.x() + px(12), pt.y() + self.app_pill.height() - 3 - self.phone.height() + px(1))
            self.phone.raise_()
        except RuntimeError:
            pass

    def showEvent(self, e):
        super().showEvent(e)
        QTimer.singleShot(0, self.place_overlay)

    def resizeEvent(self, e):
        super().resizeEvent(e)
        QTimer.singleShot(0, self.place_overlay)

    # ---------- self-update
    def mark_healthy(self):
        try:
            os.remove(APP_PENDING)
        except OSError:
            pass

    def auto_check_update(self):
        if self.sbool("auto_update", True) and not self.update_ready:
            self.updater.check(False)

    def check_update_now(self):
        self.updater.check(True)

    def on_update_state(self, kind, text):
        if kind == "installed":
            self.update_ready = text
            self.set_notice("update", f"RedGet {text} was downloaded and is ready to use.",
                            ("Later", "close"), ("Restart", "check"))
            if hasattr(self, "upd_label"):
                self.upd_label.setText(f"RedGet {text} is ready. Restart to use it.")
        elif hasattr(self, "upd_label"):
            self.upd_label.setText(text)

    def restart_app(self):
        running = [j for j in self.jobs if j.state == "running"]
        if running and QMessageBox.question(self, "Restart", "A download is still running. Restart anyway?") != QMessageBox.StandardButton.Yes:
            return
        self.close()
        os.execv(sys.executable, [sys.executable, APP_FILE if os.path.isfile(APP_FILE) else os.path.abspath(__file__)] + sys.argv[1:])

    # ---------- settings helpers
    def sbool(self, key, default):
        return str(self.settings.value(key, "true" if default else "false")).lower() == "true"

    def parts_idx(self):
        try:
            return max(0, min(len(PARTS_CHOICES) - 1, int(self.settings.value("parts_idx", 2))))
        except Exception:
            return 2

    def set_parts(self, i):
        self.settings.setValue("parts_idx", i)
        self.refresh_parts_ui()

    def set_dir(self, d):
        self.dir = d
        self.settings.setValue("dir", d)
        self.update_dir_ui()

    def set_theme(self, key):
        STYLE["theme"] = key
        self.settings.setValue("theme", key)
        self.apply_theme()

    def set_accent(self, hexcolor):
        STYLE["accent"] = hexcolor
        self.settings.setValue("accent", hexcolor)
        self.apply_theme()

    def apply_theme(self):
        app = QApplication.instance()
        t = T()
        pal = QPalette()
        R = QPalette.ColorRole
        pal.setColor(R.Window, QColor(t["panel_top"]))
        pal.setColor(R.WindowText, QColor(t["text"]))
        pal.setColor(R.Base, QColor(t["field"]))
        pal.setColor(R.Text, QColor(t["text"]))
        pal.setColor(R.Button, QColor(t["gray"]))
        pal.setColor(R.ButtonText, QColor(t["text"]))
        pal.setColor(R.PlaceholderText, QColor(t["sub"]))
        pal.setColor(R.Highlight, QColor(STYLE["accent"]))
        pal.setColor(R.HighlightedText, QColor("#ffffff"))
        app.setPalette(pal)
        app.setStyleSheet(build_qss())
        self.bgw.theme_changed()
        self.refresh_link_style()
        self.refresh_swatches()
        if hasattr(self, "theme_buttons"):
            for key, b in self.theme_buttons.items():
                b.setChecked(STYLE["theme"] == key)
        for w in self.findChildren(QWidget):
            w.update()

    # ---------- nav
    def build_nav(self):
        row = QHBoxLayout()
        row.setSpacing(px(7))
        pill = Surface(h=32)
        pl = QHBoxLayout(pill)
        pl.setContentsMargins(px(12), 0, px(8), 3)
        pl.setSpacing(px(2))
        pl.addWidget(LogoMark(17))
        pl.addSpacing(px(5))
        name = mk_label("RedGet", 13, QFont.Weight.Bold)
        pl.addWidget(name)
        pl.addStretch(1)
        self.nav_btns = []
        for i, label in enumerate(("Download", "History", "Settings")):
            b = LinkButton(label)
            b.clicked.connect(lambda _=False, i=i: self.show_page(i))
            self.nav_btns.append(b)
            pl.addWidget(b)
        self.help_btn = LinkButton("Help", chev=True)
        self.help_btn.clicked.connect(self.open_help_menu)
        pl.addWidget(self.help_btn)
        row.addWidget(pill, 1)
        self.folder_btn = PillButton("", "folder", "white", chev=True, h=32, size=11.5, pad=14)
        self.folder_btn.clicked.connect(self.open_folder_menu)
        row.addWidget(self.folder_btn)
        self.toggle = ThemeToggle()
        self.toggle.clicked.connect(lambda: self.set_theme("dark" if STYLE["theme"] == "light" else "light"))
        row.addWidget(self.toggle)
        return row

    def show_page(self, i):
        self.stack.setCurrentIndex(i)
        for j, b in enumerate(self.nav_btns):
            b.active = (j == i)
            b.update()

    def open_help_menu(self):
        m = QMenu(self)
        m.addAction("About RedGet", self.show_about)
        m.addAction("FAQ", self.show_faq)
        m.addAction("Supported sites", lambda: QDesktopServices.openUrl(QUrl(SUPPORTED_URL)))
        m.addSeparator()
        m.addAction("Check for RedGet updates", self.check_update_now)
        m.addAction("Update download engine", self.engine.run)
        m.addAction("Open the log file", self.open_log)
        m.exec(self.help_btn.mapToGlobal(QPoint(0, self.help_btn.height() + px(4))))

    def open_folder_menu(self):
        m = QMenu(self)
        m.addAction("Open the downloads folder", lambda: self.open_folder(self.dir))
        m.addAction("Change folder…", self.browse)
        m.exec(self.folder_btn.mapToGlobal(QPoint(0, self.folder_btn.height() + px(4))))

    def open_log(self):
        if os.path.isfile(LOG):
            QDesktopServices.openUrl(QUrl.fromLocalFile(LOG))
        else:
            QMessageBox.information(self, "Log", "No errors have been logged.")

    def show_about(self):
        QMessageBox.information(self, "About RedGet",
                                f"<b>RedGet {VERSION}</b><br>Paste a link, see the video, pick a quality, download.<br><br>"
                                f"Powered by yt-dlp, ffmpeg and aria2.")

    def show_faq(self):
        QMessageBox.information(
            self, "FAQ",
            "<b>How do I download?</b><br>Copy a link. RedGet shows the video; choose a quality and press Download.<br><br>"
            "<b>YouTube says 403 or asks for a JavaScript helper.</b><br>Use Help, then Update download engine.<br><br>"
            "<b>What does Download in parts do?</b><br>It splits a file into several connections to go faster. "
            "Change it from the Video Downloader menu.<br><br>"
            "<b>Where are my files?</b><br>In the folder shown at the top right of the window.")

