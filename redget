_NUM = re.compile(r"[-+]?(?:\d*\.\d+|\d+\.?)(?:[eE][-+]?\d+)?")


def svg_path(d):
    """Tiny SVG path parser (M L H V C S Z, absolute and relative)."""
    path = QPainterPath()
    toks = re.findall(r"[MmLlHhVvCcSsZz]|" + _NUM.pattern, d)
    i, cmd = 0, None
    x = y = sx = sy = 0.0
    lc = None

    def take(n):
        nonlocal i
        v = [float(t) for t in toks[i:i + n]]
        i += n
        return v
    while i < len(toks):
        t = toks[i]
        if t.isalpha():
            cmd = t
            i += 1
            if cmd in "Zz":
                path.closeSubpath()
                x, y = sx, sy
                lc = None
                continue
        rel = cmd.islower()
        c = cmd.upper()
        if c == "M":
            a, b = take(2)
            x, y = (x + a, y + b) if rel else (a, b)
            path.moveTo(x, y)
            sx, sy = x, y
            cmd = "l" if rel else "L"
            lc = None
        elif c == "L":
            a, b = take(2)
            x, y = (x + a, y + b) if rel else (a, b)
            path.lineTo(x, y)
            lc = None
        elif c == "H":
            (a,) = take(1)
            x = x + a if rel else a
            path.lineTo(x, y)
            lc = None
        elif c == "V":
            (a,) = take(1)
            y = y + a if rel else a
            path.lineTo(x, y)
            lc = None
        elif c == "C":
            v = take(6)
            if rel:
                v = [v[0] + x, v[1] + y, v[2] + x, v[3] + y, v[4] + x, v[5] + y]
            path.cubicTo(v[0], v[1], v[2], v[3], v[4], v[5])
            lc = (v[2], v[3])
            x, y = v[4], v[5]
        elif c == "S":
            v = take(4)
            if rel:
                v = [v[0] + x, v[1] + y, v[2] + x, v[3] + y]
            c1 = (2 * x - lc[0], 2 * y - lc[1]) if lc else (x, y)
            path.cubicTo(c1[0], c1[1], v[0], v[1], v[2], v[3])
            lc = (v[0], v[1])
            x, y = v[2], v[3]
        else:
            break
    return path


