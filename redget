    def refresh_engine_state(self):
        if self.engine.busy:
            return
        if not engine_exists() or (has_local_engine() and not which_in_path("deno")):
            self.set_notice("missing", "RedGet needs to set up its download engine (one-time, about 45 MB).",
                            ("Not now", "close"), ("Set up", "check"))
            if not engine_exists():
                return
        p = QProcess(self)
        p.setProcessEnvironment(proc_env())
        p.finished.connect(lambda code, _s, pp=p: self.on_version(code, pp))
        start_engine(p, ["--version"])

    def on_version(self, code, p):
        out = bytes(p.readAllStandardOutput()).decode("utf-8", "replace").strip()
        p.deleteLater()
        if code == 0 and out and not self.engine.busy:
            self.engine_version = out.splitlines()[-1]
            if self.notice_mode != "missing":
                self.set_notice("ready", f"Download engine ready  ·  {self.engine_version}", ("Settings", "close"), ("Update", "check"))

    def on_notice_no(self):
        if self.notice_mode == "update":
            self.refresh_engine_state()
        elif self.notice_mode == "missing":
            self.set_notice("tip", "Tip: copy any link and RedGet shows the video here automatically.", ("Settings", "close"), None)
        else:
            self.show_page(2)

    def on_notice_yes(self):
        if self.notice_mode == "update":
            self.restart_app()
        else:
            self.engine.run()

    def on_engine_status(self, text):
        if self.engine.busy:
            self.set_notice("busy", text)

    def on_engine_done(self, ok, msg):
        if ok:
            self.refresh_engine_state()
            if self.last_clip:
                self.show_preview(self.last_clip)
        else:
            self.set_notice("missing", msg, ("Close", "close"), ("Try again", "check"))

