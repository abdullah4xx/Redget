        d = QFileDialog.getExistingDirectory(self, "Choose download folder", self.dir)
        if d:
            self.set_dir(d)

    def open_folder(self, path):
        try:
            os.makedirs(path, exist_ok=True)
        except Exception:
            pass
        QDesktopServices.openUrl(QUrl.fromLocalFile(path))

