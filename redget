    # ---------- link entry
    def paste_or_clear(self):
        if self.url.text().strip():
            self.url.clear()
            self.card.hide()
            self.last_clip = ""
            self.src_pill.set_label("Video Downloader")
            return
        txt = QGuiApplication.clipboard().text().strip()
        m = URL_RE.search(txt)
        if m:
            link = m.group(0).rstrip(").,;")
            self.url.setText(link)
            self.last_clip = link
            self.show_preview(link)
        elif txt:
            self.url.setText(txt)

    def on_url_changed(self, *_):
        self.update_url_look()
        self.url_timer.start()
        QTimer.singleShot(0, lambda: self.url.setCursorPosition(0) if not self.url.hasFocus() else None)

    def on_url_typed(self):
        m = URL_RE.match(self.url.text().strip())
        if not m:
            return
        link = m.group(0)
        if link != self.last_clip or not self.card.isVisible():
            self.last_clip = link
            self.show_preview(link)

