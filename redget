def paint_icon(p, name, rect, color):
    fn, w = ICONS[name]
    p.save()
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.translate(rect.topLeft())
    s = min(rect.width(), rect.height()) / 24.0
    p.scale(s, s)
    p.setPen(QPen(color, w, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap, Qt.PenJoinStyle.RoundJoin))
    p.setBrush(Qt.BrushStyle.NoBrush)
    fn(p, color)
    p.restore()


def rounded_path(rect, r):
    path = QPainterPath()
    path.addRoundedRect(QRectF(rect), r, r)
    return path


def draw_shadow(p, rect, radius, strength=1.0):
    p.setPen(Qt.PenStyle.NoPen)
    for i, a in enumerate((16, 11, 7, 4)):
        p.setBrush(QColor(0, 0, 0, int(a * strength) if STYLE["theme"] == "light" else int(a * 2 * strength)))
        p.drawRoundedRect(QRectF(rect).adjusted(-i * 0.3, i * 0.6 + 0.8, i * 0.3, i * 0.9 + 1.4), radius, radius)


def red_gradient(rect):
    top, mid, bot = accent_trio()
    g = QLinearGradient(rect.topLeft(), rect.bottomLeft())
    g.setColorAt(0.0, top)
    g.setColorAt(0.55, mid)
    g.setColorAt(1.0, bot)
    return g


# ---------------------------------------------------------------- basic widgets
class ElidedLabel(QLabel):
    def __init__(self, text="", lines=1):
        super().__init__()
        self._full, self._lines = text, lines
        self.setSizePolicy(QSizePolicy.Policy.Ignored, QSizePolicy.Policy.Preferred)
        self.setMinimumWidth(0)
        self.setWordWrap(lines > 1)
        self.setText(text)

    def set_full(self, text):
        self._full = text or ""
        self.setToolTip(self._full if len(self._full) > 24 else "")
        self._elide()

    def resizeEvent(self, e):
        super().resizeEvent(e)
        self._elide()

    def _elide(self):
        w = max(20, self.width())
        fm = self.fontMetrics()
        t = self._full
        if self._lines <= 1:
            self.setText(fm.elidedText(t, Qt.TextElideMode.ElideRight, w))
            return
        limit = fm.lineSpacing() * self._lines + 2
        flags = int(Qt.TextFlag.TextWordWrap)
        if fm.boundingRect(QRect(0, 0, w, 10000), flags, t).height() <= limit:
            self.setText(t)
            return
        lo, hi = 0, len(t)
        while lo < hi:
            mid = (lo + hi + 1) // 2
            if fm.boundingRect(QRect(0, 0, w, 10000), flags, t[:mid].rstrip() + "…").height() <= limit:
                lo = mid
            else:
                hi = mid - 1
        self.setText(t[:lo].rstrip() + "…")


class PillButton(QAbstractButton):
    """kind: white | gray | red | round | roundgray | ghost"""
    def __init__(self, text="", icon="", kind="white", chev=False, h=26, size=11, bold=False, pad=12):
        super().__init__()
        self._icon, self._kind, self._chev, self._h, self._pad = icon, kind, chev, h, pad
        self._size, self._bold = size, bold
        self._hover = False
        self._dark = False
        self.setText(text)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setFocusPolicy(Qt.FocusPolicy.TabFocus)
        self.setSizePolicy(QSizePolicy.Policy.Fixed, QSizePolicy.Policy.Fixed)
        self.setFixedHeight(px(h) + 3)
        self.refit()

    def set_label(self, text, icon=None):
        self.setText(text)
        if icon is not None:
            self._icon = icon
        self.refit()
        self.update()

    def refit(self):
        f = mkfont(self._size, QFont.Weight.Bold if self._bold else QFont.Weight.DemiBold)
        self.setFont(f)
        if self._kind.startswith("round"):
            self.setFixedWidth(px(self._h) + 0)
            return
        w = px(self._pad) * 2
        fm = QFontMetrics(f)
        if self.text():
            w += fm.horizontalAdvance(self.text())
        if self._icon:
            w += px(14) + (px(6) if self.text() else 0)
        if self._chev:
            w += px(9) + px(5)
        if not self.sizePolicy().horizontalPolicy() == QSizePolicy.Policy.Ignored:
            self.setMinimumWidth(w)
        self._hint = w
        self.updateGeometry()

    def sizeHint(self):
        return QSize(getattr(self, "_hint", px(60)), self.height())

    def enterEvent(self, e):
        self._hover = True
        self.update()

    def leaveEvent(self, e):
        self._hover = False
        self.update()

    def paintEvent(self, _e):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        if not self.isEnabled():
            p.setOpacity(0.5)
        r = QRectF(0.5, 0.5, self.width() - 1, self.height() - 3.5)
        rad = r.height() / 2
        kind = "red" if (self.isCheckable() and self.isChecked()) else self._kind
        fg = C("text")
        if kind in ("white", "round"):
            draw_shadow(p, r, rad, 0.8)
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(C("pill_hover") if self._hover else C("pill"))
            p.drawRoundedRect(r, rad, rad)
        elif kind in ("gray", "roundgray"):
            p.setPen(Qt.PenStyle.NoPen)
            col = C("gray")
            p.setBrush(col.lighter(106) if self._hover else col)
            p.drawRoundedRect(r, rad, rad)
            fg = C("gray_text")
        elif kind == "red":
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(QColor(0, 0, 0, 40))
            p.drawRoundedRect(r.adjusted(0, 1.2, 0, 1.6), rad, rad)
            g = red_gradient(r)
            p.setBrush(g)
            p.setPen(QPen(accent_trio()[2].darker(115), 1))
            p.drawRoundedRect(r, rad, rad)
            hl = QLinearGradient(r.topLeft(), QPointF(r.left(), r.top() + r.height() * 0.55))
            hl.setColorAt(0, QColor(255, 255, 255, 70 if not self._hover else 95))
            hl.setColorAt(1, QColor(255, 255, 255, 0))
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(hl)
            p.drawRoundedRect(r.adjusted(1, 1, -1, -1), rad - 1, rad - 1)
            fg = QColor("#ffffff")
        else:  # ghost
            fg = C("text") if (self._hover or self._dark) else C("sub")
        fm = QFontMetrics(self.font())
        isz = px(14)
        if kind.startswith("round"):
            if self._icon:
                s = min(r.width(), r.height()) * 0.52
                paint_icon(p, self._icon, QRectF(r.center().x() - s / 2, r.center().y() - s / 2, s, s), fg)
            return
        tw = fm.horizontalAdvance(self.text()) if self.text() else 0
        total = tw + (isz + (px(6) if tw else 0) if self._icon else 0) + ((px(9) + px(5)) if self._chev else 0)
        x = r.left() + (r.width() - total) / 2
        cy = r.center().y()
        if self._icon:
            paint_icon(p, self._icon, QRectF(x, cy - isz / 2, isz, isz), fg)
            x += isz + (px(6) if tw else 0)
        if tw:
            p.setPen(fg)
            p.setFont(self.font())
            p.drawText(QRectF(x, r.top(), tw + 2, r.height()), Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft, self.text())
            x += tw
        if self._chev:
            s = px(9)
            paint_icon(p, "chevron", QRectF(x + px(5), cy - s / 2 + 0.5, s, s), fg)


class LinkButton(QAbstractButton):
    def __init__(self, text, chev=False):
        super().__init__()
        self._chev, self._hover, self.active = chev, False, False
        self.setText(text)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setSizePolicy(QSizePolicy.Policy.Fixed, QSizePolicy.Policy.Fixed)
        self.refit()

    def refit(self):
        self.setFont(mkfont(12, QFont.Weight.DemiBold))
        w = QFontMetrics(self.font()).horizontalAdvance(self.text()) + px(22) + (px(14) if self._chev else 0)
        self.setFixedSize(w, px(30))

    def enterEvent(self, e):
        self._hover = True
        self.update()

    def leaveEvent(self, e):
        self._hover = False
        self.update()

    def paintEvent(self, _e):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        col = C("text") if (self._hover or self.active) else C("sub")
        f = mkfont(12, QFont.Weight.Bold if self.active else QFont.Weight.DemiBold)
        p.setFont(f)
        p.setPen(col)
        tw = QFontMetrics(f).horizontalAdvance(self.text())
        total = tw + (px(14) if self._chev else 0)
        x = (self.width() - total) / 2
        p.drawText(QRectF(x, 0, tw + 2, self.height()), Qt.AlignmentFlag.AlignVCenter, self.text())
        if self._chev:
            s = px(9)
            paint_icon(p, "chevron", QRectF(x + tw + px(5), self.height() / 2 - s / 2 + 1, s, s), col)


class Surface(QWidget):
    """White pill / card with soft shadow."""
    def __init__(self, radius=None, h=None):
        super().__init__()
        self._radius = radius
        if h:
            self.setFixedHeight(px(h) + 3)

    def paintEvent(self, _e):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        r = QRectF(0.5, 0.5, self.width() - 1, self.height() - 3.5)
        rad = self._radius if self._radius else r.height() / 2
        draw_shadow(p, r, rad)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(C("pill") if self._radius is None else C("card"))
        p.drawRoundedRect(r, rad, rad)


class Chip(QWidget):
    def __init__(self, icon, text=""):
        super().__init__()
        self.icon, self.text = icon, text
        self.setSizePolicy(QSizePolicy.Policy.Fixed, QSizePolicy.Policy.Fixed)
        self.refit()

    def set_text(self, t):
        self.text = t
        self.refit()
        self.update()

    def refit(self):
        f = mkfont(9, QFont.Weight.DemiBold)
        w = QFontMetrics(f).horizontalAdvance(self.text) + px(8) * 2 + px(10) + px(4)
        self.setFixedSize(w, px(18))

    def paintEvent(self, _e):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        r = QRectF(self.rect())
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(C("chip"))
        p.drawRoundedRect(r, r.height() / 2, r.height() / 2)
        col = C("chip_text")
        s = px(10)
        paint_icon(p, self.icon, QRectF(px(8), r.center().y() - s / 2, s, s), col)
        p.setPen(col)
        p.setFont(mkfont(9, QFont.Weight.DemiBold))
        p.drawText(QRectF(px(8) + s + px(4), 0, r.width(), r.height()), Qt.AlignmentFlag.AlignVCenter, self.text)


class LogoMark(QWidget):
    def __init__(self, size=17):
        super().__init__()
        self.setFixedSize(px(size), px(size))

    def paintEvent(self, _e):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        w = self.width()
        p.translate(w / 2, w / 2)
        p.rotate(45)
        s = w * 0.62
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QColor("#17181b") if STYLE["theme"] == "light" else QColor("#f3f3f5"))
        p.drawRoundedRect(QRectF(-s / 2, -s / 2, s, s), s * 0.22, s * 0.22)
        p.rotate(-45)
        paint_icon(p, "download", QRectF(-w * 0.2, -w * 0.2, w * 0.4, w * 0.4),
                   QColor("#ffffff") if STYLE["theme"] == "light" else QColor("#17181b"))


