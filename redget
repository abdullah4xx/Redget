        os.makedirs(DATA_DIR, exist_ok=True)
        tmp = HIST_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(items[:200], f, ensure_ascii=False, indent=1)
        os.replace(tmp, HIST_FILE)
    except Exception as e:
        log_error("save_history: " + repr(e))


# ---------------------------------------------------------------- engine (yt-dlp + JavaScript helper)
def which_in_path(name):
    return shutil.which(name, path=BIN_DIR + os.pathsep + os.environ.get("PATH", ""))


def has_local_engine():
    return os.path.isfile(LOCAL_YTDLP)


def engine_cmd():
    return LOCAL_YTDLP if has_local_engine() else (shutil.which("yt-dlp") or "yt-dlp")


def engine_exists():
    return has_local_engine() or shutil.which("yt-dlp") is not None


def proc_env():
    env = QProcessEnvironment.systemEnvironment()
    env.insert("PATH", BIN_DIR + os.pathsep + env.value("PATH", ""))
    env.insert("PYTHONIOENCODING", "utf-8")
    return env


def start_engine(proc, args):
    """Start yt-dlp in its own process group so cancel/quit also stops aria2c/ffmpeg children."""
    exe = engine_cmd()
    if SETSID:
        proc.start(SETSID, ["--", exe] + args)
    else:
        proc.start(exe, args)


def kill_group(proc, sig):
    pid = proc.processId()
    try:
        if pid and SETSID:
            os.killpg(pid, sig)
            return
    except Exception:
        pass
    try:
        proc.terminate() if sig == signal.SIGTERM else proc.kill()
    except Exception:
        pass


def deno_name():
    arch = platform.machine().lower()
    return "deno-aarch64-unknown-linux-gnu.zip" if arch in ("aarch64", "arm64") else "deno-x86_64-unknown-linux-gnu.zip"


def find_hash(text, name):
    for line in text.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[-1].lstrip("*") == name and re.fullmatch(r"[0-9a-fA-F]{64}", parts[0]):
            return parts[0].lower()
    m = re.fullmatch(r"\s*([0-9a-fA-F]{64})\s*", text)
    return m.group(1).lower() if m else ""


class Engine(QObject):
    status = pyqtSignal(str)
    finished = pyqtSignal(bool, str)

    def __init__(self, nam):
        super().__init__()
        self.nam = nam
        self.busy = False
        self.want = ""

    def run(self):
        if self.busy:
            return
        self.busy = True
        try:
            os.makedirs(BIN_DIR, exist_ok=True)
        except Exception as e:
            self.fail(f"Couldn't create the engine folder: {e}")
            return
        self.status.emit("Checking the download engine…")
        self.get(YTDLP_SUMS_URL, "checksums", self.got_sums)

    def get(self, url, label, cb):
        req = QNetworkRequest(QUrl(url))
        req.setAttribute(QNetworkRequest.Attribute.RedirectPolicyAttribute,
                         QNetworkRequest.RedirectPolicy.NoLessSafeRedirectPolicy)
        req.setTransferTimeout(60000)
        reply = self.nam.get(req)
        reply.downloadProgress.connect(
            lambda r, t, l=label: self.status.emit(f"Updating {l}… {int(r * 100 / t)}%" if t > 0 and l != "checksums" else f"Updating {l}…"))
        reply.finished.connect(lambda r=reply: cb(r))

    def fail(self, msg):
        self.busy = False
        self.status.emit(msg)
        self.finished.emit(False, msg)

    def take(self, reply, what):
        try:
            if reply.error() != QNetworkReply.NetworkError.NoError:
                self.fail(f"Couldn't download the {what}. Check your connection and try again.")
                return None
            return bytes(reply.readAll())
        finally:
            reply.deleteLater()

    def got_sums(self, reply):
        data = self.take(reply, "engine checksums")
        if data is None:
            return
        self.want = find_hash(data.decode("utf-8", "replace"), "yt-dlp")
        if not self.want:
            self.fail("Couldn't verify the download engine (no checksum found). Nothing was installed.")
            return
        self.get(YTDLP_URL, "download engine", self.got_ytdlp)

    def got_ytdlp(self, reply):
        data = self.take(reply, "engine")
        if data is None:
            return
        if len(data) < 100000 or hashlib.sha256(data).hexdigest() != self.want:
            self.fail("The engine download failed its integrity check. Nothing was installed.")
            return
        try:
            tmp = LOCAL_YTDLP + ".new"
            with open(tmp, "wb") as f:
                f.write(data)
            os.chmod(tmp, 0o755)
            os.replace(tmp, LOCAL_YTDLP)
        except Exception as e:
            self.fail(f"Couldn't save the engine: {e}")
            return
        if which_in_path("deno"):
            self.done()
        else:
            self.get("https://github.com/denoland/deno/releases/latest/download/" + deno_name() + ".sha256sum",
                     "checksums", self.got_deno_sum)

    def got_deno_sum(self, reply):
        data = self.take(reply, "JavaScript helper checksum")
        if data is None:
            return
        self.want = find_hash(data.decode("utf-8", "replace"), deno_name())
        if not self.want:
            self.fail("Couldn't verify the JavaScript helper (no checksum found). It was not installed.")
            return
        self.get("https://github.com/denoland/deno/releases/latest/download/" + deno_name(),
                 "JavaScript helper", self.got_deno)

    def got_deno(self, reply):
        data = self.take(reply, "JavaScript helper")
        if data is None:
            return
        if hashlib.sha256(data).hexdigest() != self.want:
            self.fail("The JavaScript helper failed its integrity check. It was not installed.")
            return
        try:
            with zipfile.ZipFile(io.BytesIO(data)) as z:
                with z.open("deno") as src, open(LOCAL_DENO + ".new", "wb") as dst:
                    shutil.copyfileobj(src, dst)
            os.chmod(LOCAL_DENO + ".new", 0o755)
            os.replace(LOCAL_DENO + ".new", LOCAL_DENO)
        except Exception as e:
            self.fail(f"Couldn't set up the JavaScript helper: {e}")
            return
        self.done()

    def done(self):
        self.busy = False
        self.status.emit("Engine is up to date")
        self.finished.emit(True, "Engine is up to date")


# ---------------------------------------------------------------- self-update (GitHub)
def vtuple(v):
    try:
        return tuple(int(x) for x in re.findall(r"\d+", str(v))[:4])
    except Exception:
        return (0,)


def read_file_version(path):
    try:
        with open(path, encoding="utf-8") as f:
            m = re.search(r'^VERSION = "([^"]+)"', f.read(8192), re.M)
        return m.group(1) if m else ""
    except Exception:
        return ""


def maybe_run_newer():
    """Run the copy downloaded by the updater if it is newer than the installed one.
    A downloaded version that never reached a working window is discarded on the next start."""
    if os.environ.get("REDGET_NO_OVERRIDE"):
        return
    try:
        if os.path.isfile(APP_PENDING):
            bad = read_file_version(APP_FILE)
            shutil.rmtree(APP_DIR, ignore_errors=True)
            os.makedirs(DATA_DIR, exist_ok=True)
            with open(SKIP_FILE, "w") as f:
                f.write(bad)
            log_error(f"downloaded version {bad} did not start cleanly; using the installed version")
            return
        if not os.path.isfile(APP_FILE):
            return
        if os.path.realpath(APP_FILE) == os.path.realpath(os.path.abspath(__file__)):
            return
        v = read_file_version(APP_FILE)
        if v and vtuple(v) > vtuple(VERSION):
            with open(APP_PENDING, "w") as f:
                f.write(v)
            os.execv(sys.executable, [sys.executable, APP_FILE] + sys.argv[1:])
        else:
            shutil.rmtree(APP_DIR, ignore_errors=True)
    except Exception as e:
        log_error("maybe_run_newer: " + repr(e))


class SelfUpdater(QObject):
    """Checks version.json in the GitHub repo; downloads, verifies (SHA-256 + syntax) and stores a new redget."""
    state = pyqtSignal(str, str)   # kind: checking | uptodate | installed | error, text

    def __init__(self, nam):
        super().__init__()
        self.nam = nam
        self.busy = False
        self.manual = False
        self.meta = {}

    def check(self, manual=False):
        if self.busy:
            return
        self.busy, self.manual = True, manual
        if manual:
            self.state.emit("checking", "Checking for updates…")
        self.get(UPDATE_RAW + "version.json", self.got_meta)

    def get(self, url, cb):
        req = QNetworkRequest(QUrl(url))
        req.setAttribute(QNetworkRequest.Attribute.RedirectPolicyAttribute,
                         QNetworkRequest.RedirectPolicy.NoLessSafeRedirectPolicy)
        req.setRawHeader(b"Cache-Control", b"no-cache")
        req.setTransferTimeout(30000)
        reply = self.nam.get(req)
        reply.finished.connect(lambda r=reply: cb(r))

    def fail(self, msg):
        self.busy = False
        if self.manual:
            self.state.emit("error", msg)
        else:
            log_error("self-update: " + msg)

    def got_meta(self, reply):
        try:
            if reply.error() != QNetworkReply.NetworkError.NoError:
                self.fail("Couldn't reach GitHub. Check your connection.")
                return
            meta = json.loads(bytes(reply.readAll()).decode("utf-8"))
            ver, sha = str(meta["version"]), str(meta["sha256"]).lower()
            if not re.fullmatch(r"[0-9a-f]{64}", sha):
                raise ValueError("bad checksum field")
        except Exception as e:
            self.fail(f"The update information is not valid ({e}).")
            return
        finally:
            reply.deleteLater()
        skip = ""
        try:
            with open(SKIP_FILE) as f:
                skip = f.read().strip()
        except Exception:
            pass
        current = max((vtuple(VERSION), vtuple(read_file_version(APP_FILE))))
        if vtuple(ver) <= current or (ver == skip and not self.manual):
            self.busy = False
            if self.manual:
                self.state.emit("uptodate", f"RedGet {VERSION} is up to date")
            return
        self.meta = dict(version=ver, sha256=sha, file=str(meta.get("file", "redget")))
        if not re.fullmatch(r"[A-Za-z0-9._-]+", self.meta["file"]):
            self.fail("The update information is not valid (file name).")
            return
        self.state.emit("checking", f"Downloading RedGet {ver}…")
        self.get(UPDATE_RAW + self.meta["file"], self.got_file)

    def got_file(self, reply):
        try:
            if reply.error() != QNetworkReply.NetworkError.NoError:
                self.fail("Couldn't download the update.")
                return
            data = bytes(reply.readAll())
        finally:
            reply.deleteLater()
        try:
            if hashlib.sha256(data).hexdigest() != self.meta["sha256"]:
                self.fail("The update failed its integrity check. It was not installed.")
                return
            compile(data, "redget", "exec")
            m = re.search(rb'^VERSION = "([^"]+)"', data[:8192], re.M)
            if not m or m.group(1).decode() != self.meta["version"]:
                self.fail("The update doesn't match its announced version. It was not installed.")
                return
            os.makedirs(APP_DIR, exist_ok=True)
            tmp = APP_FILE + ".new"
            with open(tmp, "wb") as f:
                f.write(data)
            os.chmod(tmp, 0o755)
            os.replace(tmp, APP_FILE)
            try:
                os.remove(SKIP_FILE)
            except OSError:
                pass
        except Exception as e:
            self.fail(f"Couldn't install the update: {e}")
            return
        self.busy = False
        self.state.emit("installed", self.meta["version"])


# ---------------------------------------------------------------- link info
SITE_NAMES = {"youtube": "YouTube", "tiktok": "TikTok", "twitter": "X", "instagram": "Instagram",
              "facebook": "Facebook", "vimeo": "Vimeo", "soundcloud": "SoundCloud", "twitch": "Twitch",
              "reddit": "Reddit", "dailymotion": "Dailymotion", "bilibili": "Bilibili"}


def parse_probe(raw, url):
    info = json.loads(raw)
    ent, count = info, None
    is_playlist = "list=" in url
    title = ""
    if info.get("_type") == "playlist":
        is_playlist = True
        ents = [e for e in (info.get("entries") or []) if e]
        ent = ents[0] if ents else {}
        count = info.get("playlist_count") or info.get("n_entries")
        title = info.get("title") or ""
    title = title or ent.get("title") or ""
    site = str(ent.get("extractor") or info.get("extractor") or "").split(":")[0].lower()
    dur = ent.get("duration_string") or fmt_duration(ent.get("duration")) or ""
    return dict(title=title, uploader=ent.get("uploader") or ent.get("channel") or info.get("uploader") or "",
                duration=dur, thumb=ent.get("thumbnail") or info.get("thumbnail") or "",
                formats=ent.get("formats") or [], playlist=is_playlist, count=count,
                pure_playlist=(info.get("_type") == "playlist" and "v=" not in url),
                site=SITE_NAMES.get(site, site.capitalize() if site and site != "generic" else ""),
                date=fmt_date(ent.get("upload_date")), views=ent.get("view_count"),
                likes=ent.get("like_count"), comments=ent.get("comment_count"))


def quality_items(formats):
    """-> list of (label, payload, size_bytes)"""
    items = []
    sizes, audio = {}, 0
    for f in formats:
        size = f.get("filesize") or f.get("filesize_approx") or 0
        h = f.get("height")
        if f.get("vcodec") not in (None, "none") and h:
            sizes[int(h)] = max(sizes.get(int(h), 0), size)
        elif f.get("acodec") not in (None, "none"):
            audio = max(audio, size)
    heights = sorted(sizes, reverse=True) if sizes else GENERIC_HEIGHTS
    for h in heights:
        if h < 144:
            continue
        label = f"{h}p" + (" (4K)" if h == 2160 else "")
        items.append((label, ("video", h), (sizes.get(h, 0) + audio) if sizes.get(h) else 0))
    for label, ext in AUDIO_CHOICES:
        items.append((label, ("audio", ext), 0))
    return items


def default_quality(items):
    for i, (_l, pl, _s) in enumerate(items):
        if pl[0] == "video" and pl[1] <= 1080:
            return i
    return 0


# ---------------------------------------------------------------- download jobs
class JobWidget(QWidget):
    def __init__(self, url):
        super().__init__()
        lay = QVBoxLayout(self)
        lay.setContentsMargins(px(16), px(10), px(12), px(13))
        lay.setSpacing(px(5))
        top = QHBoxLayout()
        self.title = ElidedLabel(url)
        self.title.setFont(mkfont(11.5, QFont.Weight.Bold))
        self.btn = PillButton("", "close", "roundgray", h=22)
        top.addWidget(self.title, 1)
        top.addWidget(self.btn)
        self.bar = QProgressBar()
        self.bar.setRange(0, 1000)
        self.bar.setTextVisible(False)
        self.bar.setFixedHeight(px(6))
        self.status = ElidedLabel("Waiting")
        self.status.setFont(mkfont(10))
        self.status.setProperty("role", "muted")
        lay.addLayout(top)
        lay.addWidget(self.bar)
        lay.addWidget(self.status)

    def paintEvent(self, _e):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        r = QRectF(0.5, 0.5, self.width() - 1, self.height() - 3.5)
        draw_shadow(p, r, px(16))
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(C("card"))
        p.drawRoundedRect(r, px(16), px(16))

    def set_title(self, text):
        self.title.set_full(text)

    def set_status(self, text):
        self.status.set_full(text)


class Job(QObject):
    done = pyqtSignal(object, str)

    def __init__(self, url, args, fallback, outdir, kind, widget, playlist):
        super().__init__()
        self.url, self.args, self.fallback, self.outdir, self.kind = url, args, fallback, outdir, kind
        self.w, self.playlist = widget, playlist
        self.proc = None
        self.buf = ""
        self.idx, self.total = 1, 1
        self.streams, self.stream_idx, self.last_fn = 1, 0, None
        self.cancelled = False
        self.retried = False
        self.ended = False
        self.state = "queued"
        self.title = url
        self.dest = ""
        self.err = ""

    def start(self):
        self.state = "running"
        if not engine_exists():
            self.err = "The download engine is missing. Set it up from the bar below."
            self.finish("fail")
            return
        if self.proc is not None:
            self.proc.deleteLater()
        self.buf = ""
        self.proc = QProcess(self)
        self.proc.setProcessEnvironment(proc_env())
        self.proc.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        self.proc.readyReadStandardOutput.connect(self.read)
        self.proc.finished.connect(self.finished)
        self.proc.errorOccurred.connect(self.errored)
        self.w.set_status("Starting…")
        start_engine(self.proc, self.args + ["--", self.url])

    def read(self):
        self.buf += bytes(self.proc.readAllStandardOutput()).decode("utf-8", "replace")
        parts = re.split(r"[\r\n]+", self.buf)
        self.buf = parts.pop()
        if len(self.buf) > 20000:
            self.buf = ""
        for line in parts:
            line = line.strip()
            if line:
                self.handle(line)

    def handle(self, line):
        if line.startswith("RG_DL" + SEP):
            f = line.split(SEP)
            if len(f) < 7:
                return
            down = num(f[1])
            tot = num(f[2]) or num(f[3])
            fn = f[6]
            if self.last_fn is not None and fn != self.last_fn and self.stream_idx < self.streams - 1:
                self.stream_idx += 1
            self.last_fn = fn
            pct = max(0.0, min(1.0, down / tot)) if (down is not None and tot) else 0.0
            overall = ((self.idx - 1) + (self.stream_idx + pct) / max(self.streams, 1)) / max(self.total, 1)
            self.w.bar.setValue(int(overall * 1000))
            txt = f"{pct * 100:.0f}%" if tot else "Downloading…"
            if self.total > 1:
                txt = f"Video {self.idx} of {self.total}, " + txt
            sp, eta = fmt_speed(num(f[4])), fmt_eta(num(f[5]))
            if sp:
                txt += f", {sp}"
            if eta:
                txt += f", {eta} left"
            self.w.set_status(txt)
        elif line.startswith("RG_PP" + SEP):
            f = line.split(SEP)
            if len(f) >= 3 and f[2] == "started":
                name = f[1]
                self.w.set_status({"Merger": "Merging audio and video…", "ExtractAudio": "Converting audio…"}.get(name, "Finishing…"))
        elif line.startswith("RG_ITEM" + SEP):
            f = line.split(SEP)
            if len(f) >= 5:
                self.idx = int(num(f[1]) or 1)
                self.total = int(num(f[2]) or 1)
                self.streams = 2 if f[4] else 1
                self.stream_idx, self.last_fn = 0, None
                if f[3] and f[3] != "NA":
                    self.title = f[3]
                    self.w.set_title(f[3])
                if self.total > 1:
                    self.w.set_status(f"Video {self.idx} of {self.total}")
        elif line.startswith("RG_DONE" + SEP):
            self.dest = line.split(SEP, 1)[1]
            self.title = os.path.basename(self.dest) or self.title
            self.w.set_title(self.title)
        elif line.startswith("ERROR"):
            self.err = re.sub(r"^ERROR:\s*(\[[^\]]+\]\s*)?", "", line)
        elif "failed to execute" in line.lower() and not self.err:
            self.err = "The download engine is missing. Set it up from the bar below."

    def finish(self, state):
        if self.ended:
            return
        self.ended = True
        self.state = state
        self.done.emit(self, state)

    def finished(self, code, _status):
        if self.buf.strip():
            self.handle(self.buf.strip())
            self.buf = ""
        if self.cancelled:
            self.finish("cancel")
        elif code == 0:
            self.finish("ok")
        elif self.fallback and not self.retried:
            self.retried = True
            self.args = self.fallback
            self.err = ""
            self.idx, self.stream_idx, self.last_fn = 1, 0, None
            self.w.bar.setValue(0)
            self.w.set_status("Parallel mode was refused, trying a safer way…")
            QTimer.singleShot(200, self.start)
        else:
            self.finish("fail")

    def errored(self, error):
        if error == QProcess.ProcessError.FailedToStart:
            self.err = "The download engine is missing. Set it up from the bar below."
            self.finish("fail")

    def cancel(self):
        self.cancelled = True
        if self.proc and self.proc.state() != QProcess.ProcessState.NotRunning:
            kill_group(self.proc, signal.SIGTERM)
            QTimer.singleShot(3000, self.kill_if_alive)

    def kill_if_alive(self):
        if self.proc and self.proc.state() != QProcess.ProcessState.NotRunning:
            kill_group(self.proc, signal.SIGKILL)


