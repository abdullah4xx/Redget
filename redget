def pick_family():
    have = set(QFontDatabase.families())
    for name in ("Hanken Grotesk", "Sofia Sans", "Space Grotesk", "Instrument Sans", "Manrope",
                 "Plus Jakarta Sans", "Inter", "Noto Sans", "Cantarell", "Ubuntu", "DejaVu Sans"):
        if name in have:
            return name
    return QApplication.font().family()


def log_error(msg):
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        if os.path.isfile(LOG) and os.path.getsize(LOG) > 1_000_000:
            os.replace(LOG, LOG + ".old")
        with open(LOG, "a", encoding="utf-8") as f:
            f.write(time.strftime("[%Y-%m-%d %H:%M:%S] ") + msg + "\n")
    except Exception:
        pass


def excepthook(et, ev, tb):
    log_error("".join(traceback.format_exception(et, ev, tb)))


