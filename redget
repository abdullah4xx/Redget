        p.drawRect(QRectF(self.rect()).adjusted(0.5, 0.5, -0.5, -0.5))


class StripWidget(QWidget):
    """Gray glass strip at the bottom of the result card (blurred thumbnail behind the controls)."""
    def __init__(self):
        super().__init__()
        self.thumb = None

    def set_thumb(self, pix):
        self.thumb = pix
        self.update()

    def paintEvent(self, _e):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        r = QRectF(self.rect()).adjusted(0, 0, 0, -1)
        rad = px(16)
        path = rounded_path(r, rad)
        p.setClipPath(path)
        g = QLinearGradient(r.topLeft(), r.bottomLeft())
        g.setColorAt(0, C("strip_top"))
        g.setColorAt(1, C("strip_bot"))
        p.fillRect(r, g)
        if self.thumb is not None and not self.thumb.isNull():
            s = self.thumb.scaled(max(1, int(r.width() // 18)), max(1, int(r.height() // 18)),
                                  Qt.AspectRatioMode.IgnoreAspectRatio, Qt.TransformationMode.SmoothTransformation)
            s = s.scaled(int(r.width()), int(r.height()), Qt.AspectRatioMode.IgnoreAspectRatio,
                         Qt.TransformationMode.SmoothTransformation)
            p.setOpacity(0.32)
            p.drawPixmap(0, 0, s)
            p.setOpacity(1)
            p.fillRect(r, QColor(140, 140, 140, 90))
        else:
            n = 16
            for i in range(n):
                a = 14 + (i * 37) % 26
                p.fillRect(QRectF(r.width() * i / n, 0, r.width() / n * 0.5, r.height()), QColor(255, 255, 255, a))


def rounded_pix(pix, w, h, r, dpr=1.0):
    W, H = int(w * dpr), int(h * dpr)
    pix = pix.scaled(W, H, Qt.AspectRatioMode.KeepAspectRatioByExpanding, Qt.TransformationMode.SmoothTransformation)
    out = QPixmap(W, H)
    out.fill(Qt.GlobalColor.transparent)
    p = QPainter(out)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setClipPath(rounded_path(QRectF(0, 0, W, H), r * dpr))
    p.drawPixmap((W - pix.width()) // 2, (H - pix.height()) // 2, pix)
    p.end()
    out.setDevicePixelRatio(dpr)
    return out


# ---------------------------------------------------------------- helpers
def fmt_size(n):
    mb = n / 1048576.0
    return f"{mb / 1024:.1f} GB" if mb >= 1024 else f"{mb:.0f} MB"


def fmt_count(n):
    try:
        n = float(n)
    except Exception:
        return ""
    for lim, suf in ((1e9, "B"), (1e6, "M"), (1e3, "K")):
        if n >= lim:
            v = n / lim
            return (f"{v:.1f}".rstrip("0").rstrip(".") if v < 100 else f"{v:.0f}") + suf
    return str(int(n))


def fmt_speed(bps):
    try:
        bps = float(bps)
    except Exception:
        return ""
    return f"{bps / 1048576:.1f} MB/s" if bps >= 1048576 else f"{bps / 1024:.0f} KB/s"


def fmt_eta(s):
    try:
        s = int(float(s))
    except Exception:
        return ""
    h, r = divmod(s, 3600)
    m, sec = divmod(r, 60)
    return f"{h}:{m:02d}:{sec:02d}" if h else f"{m}:{sec:02d}"


def fmt_duration(sec):
    try:
        sec = int(sec)
    except Exception:
        return ""
    return fmt_eta(sec)


def fmt_date(s):
    s = str(s or "")
    if len(s) >= 6 and s[:6].isdigit():
        m = int(s[4:6])
        if 1 <= m <= 12:
            return f"{MONTHS[m - 1]} {s[:4]}"
    return ""


def num(v):
    try:
        f = float(v)
        return f
    except Exception:
        return None


def load_history():
    try:
        with open(HIST_FILE, encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, list) else []
