    def check_clipboard(self):
        if not self.sbool("detect", True):
            return
        try:
            text = self.clip.text()
        except Exception:
            return
        m = URL_RE.search(text or "")
        if not m:
            return
        link = m.group(0).rstrip(").,;")
        if link == self.clip_seen:
            return
        self.clip_seen = link
        if link == self.last_clip:
            return
        self.last_clip = link
        self.url.setText(link)
        self.show_preview(link)

    # ---------- video preview
    def show_preview(self, link):
        self.card.show()
        self.thumb_pix = None
        self.strip.set_thumb(None)
        self.pv_thumb.clear()
        self.pv_thumb.setText("▶")
        self.pv_title.set_full(link)
        self.pv_meta.set_full("Reading the link…")
        self.set_chips(None)
        self.playlist.hide()
        self.playlist.setChecked(False)
        generic = [(f"{h}p" + (" (4K)" if h == 2160 else ""), ("video", h), 0) for h in GENERIC_HEIGHTS] + \
                  [(l, ("audio", e), 0) for l, e in AUDIO_CHOICES]
        self.set_quality_items(generic)
        self.src_pill.set_label("Video Downloader")
        self.probe(link)

    def probe(self, link):
        old = self.probe_proc
        if not engine_exists():
            self.pv_meta.set_full("The download engine is missing. Set it up from the bar below.")
            return
        p = QProcess(self)
        self.probe_proc = p
        p.setProcessEnvironment(proc_env())
        p.setProcessChannelMode(QProcess.ProcessChannelMode.SeparateChannels)
        timer = QTimer(p)
        timer.setSingleShot(True)
        timer.timeout.connect(lambda pp=p: kill_group(pp, signal.SIGKILL))
        p.finished.connect(lambda code, _st, pp=p, l=link: self.probe_done(pp, l, code))
        start_engine(p, ["-J", "--no-playlist", "--playlist-items", "1", "--no-warnings", "--skip-download", "--", link])
        timer.start(45000)
        if old is not None and old.state() != QProcess.ProcessState.NotRunning:
            kill_group(old, signal.SIGKILL)

    def probe_done(self, p, link, code):
        try:
            if p is not self.probe_proc or link != self.last_clip:
                p.deleteLater()
                return
            raw = bytes(p.readAllStandardOutput()).decode("utf-8", "replace")
            info = None
            if code == 0 and raw.strip():
                try:
                    info = parse_probe(raw, link)
                except Exception as e:
                    log_error("probe parse: " + repr(e))
            if info is None:
                err = bytes(p.readAllStandardError()).decode("utf-8", "replace")
                if "403" in err or "JavaScript" in err or not has_local_engine():
                    self.refresh_engine_state()
                self.pv_meta.set_full("Couldn't read this link. You can still choose a quality and try.")
                return
            self.pv_title.set_full(info["title"] or link)
            if info["playlist"]:
                meta = "Playlist" + (f", {info['count']} videos" if info["count"] else "")
                if info["uploader"]:
                    meta = f"By {info['uploader']}  ·  " + meta
                self.playlist.show()
                self.playlist.setChecked(bool(info["pure_playlist"]))
            else:
                meta = ("By " + info["uploader"]) if info["uploader"] else ""
            self.pv_meta.set_full(meta)
            self.set_chips(info)
            if info["site"]:
                self.src_pill.set_label(f"{info['site']} Downloader")
            self.set_quality_items(quality_items(info["formats"]))
            if info["thumb"].startswith("http"):
                self.fetch_thumb(link, info["thumb"])
        except RuntimeError:
            pass
        finally:
            try:
                p.deleteLater()
            except RuntimeError:
                pass

    def fetch_thumb(self, link, turl):
        turl = turl.replace("/vi_webp/", "/vi/").replace(".webp", ".jpg")
        req = QNetworkRequest(QUrl(turl))
        req.setAttribute(QNetworkRequest.Attribute.RedirectPolicyAttribute,
                         QNetworkRequest.RedirectPolicy.NoLessSafeRedirectPolicy)
        req.setTransferTimeout(20000)
        reply = self.nam.get(req)
        reply.finished.connect(lambda r=reply, l=link: self.thumb_done(r, l))

    def thumb_done(self, reply, link):
        try:
            if reply.error() == QNetworkReply.NetworkError.NoError and link == self.last_clip:
                pix = QPixmap()
                if pix.loadFromData(bytes(reply.readAll())):
                    self.thumb_pix = pix
                    self.pv_thumb.setText("")
                    self.pv_thumb.setPixmap(rounded_pix(pix, px(124), px(70), px(9), self.devicePixelRatioF()))
                    self.strip.set_thumb(pix)
        finally:
            reply.deleteLater()

    # ---------- downloading
    def on_download(self):
        urls = [u for u in self.url.text().split() if URL_RE.match(u)]
        if not urls:
            self.pv_meta.set_full("Paste a link that starts with http:// or https://")
            return
        if not self.q_items:
            self.open_quality_menu()
            return
        self.add_jobs(urls, self.q_items[self.q_idx][1])

    def build_args(self, payload, outdir, playlist):
        if playlist:
            tmpl = "%(playlist_title,title).100s/%(playlist_index|0)s - %(title).150s.%(ext)s"
        else:
            tmpl = "%(title).150s.%(ext)s"
        base = ["--newline", "--no-colors", "--progress", "--no-simulate",
                "--yes-playlist" if playlist else "--no-playlist",
                "--retries", "10", "--fragment-retries", "10", "--socket-timeout", "30", "--embed-metadata",
                "--progress-template",
                "download:RG_DL" + SEP + SEP.join("%(progress." + k + ")s" for k in
                                                  ("downloaded_bytes", "total_bytes", "total_bytes_estimate", "speed", "eta", "filename")),
                "--progress-template", "postprocess:RG_PP" + SEP + "%(progress.postprocessor)s" + SEP + "%(progress.status)s",
                "--print", "before_dl:RG_ITEM" + SEP + SEP.join(["%(playlist_index)s", "%(playlist_count)s", "%(title)s",
                                                                  "%(requested_formats.1.format_id|)s"]),
                "--print", "after_move:RG_DONE" + SEP + "%(filepath)s",
                "-o", os.path.join(outdir, tmpl)]
        kind, val = payload
        if kind == "audio":
            fmt = ["-x", "--audio-format", val, "--audio-quality", "0", "-f", "ba/b"]
        else:
            fmt = ["-f", f"bv*[height<={val}]+ba/b[height<={val}]", "-S", "res,ext:mp4:m4a", "--merge-output-format", "mp4"]
        parts = PARTS_CHOICES[self.parts_idx()][1]
        if parts == 0:
            return base + ["-N", "1"] + fmt, None
        safe = base + ["-N", str(parts), "--http-chunk-size", "10M"] + fmt
        if shutil.which("aria2c"):
            p = min(parts, 8)
            fast = base + ["-N", str(parts), "--downloader", "dash,m3u8:native", "--downloader", "aria2c",
                           "--downloader-args", f"aria2c:-x {p} -s {p} -k 1M -j {p} --file-allocation=none"] + fmt
            return fast, safe
        return safe, None

    def add_jobs(self, urls, payload):
        try:
            os.makedirs(self.dir, exist_ok=True)
        except Exception as e:
            self.pv_meta.set_full(f"Can't use this folder: {e}")
            return
        playlist = self.playlist.isVisible() and self.playlist.isChecked()
        single_title = self.pv_title._full if len(urls) == 1 and self.thumb_pix is not None or (len(urls) == 1 and self.chips["dur"].isVisible()) else ""
        for u in urls:
            args, fallback = self.build_args(payload, self.dir, playlist)
            widget = JobWidget(u)
            job = Job(u, args, fallback, self.dir, "audio" if payload[0] == "audio" else "video", widget, playlist)
            if single_title:
                widget.set_title(single_title)
                job.title = single_title
            job.done.connect(self.on_done)
            widget.btn.clicked.connect(lambda _=False, j=job: self.cancel_job(j))
            self.jobs_lay.insertWidget(0, widget)
            self.jobs.append(job)
        self.url.clear()
        self.last_clip = ""
        self.card.hide()
        self.src_pill.set_label("Video Downloader")
        self.refresh_layout_state()
        self.next_job()

    def refresh_layout_state(self):
        has = len(self.jobs) > 0
        self.qhead.setVisible(has)
        self.scroll.setVisible(has)
        sp = self.card.sizePolicy()
        sp.setRetainSizeWhenHidden(not has)
        self.card.setSizePolicy(sp)
        self.card.setMinimumHeight(px(139))
        self.card.updateGeometry()
        self.heading.setVisible(not has)
        self.terms.setVisible(not has)

    def next_job(self):
        if self.current is not None:
            return
        for job in self.jobs:
            if job.state == "queued" and not job.cancelled:
                self.current = job
                job.start()
                return

    def cancel_job(self, job):
        if job.state == "running":
            job.cancel()
        elif job.state == "queued":
            job.cancelled = True
            job.state = "cancel"
            job.w.set_status("Cancelled")
            job.w.btn.set_label("", "close")
        else:
            self.remove_job(job)

    def remove_job(self, job):
        if job in self.jobs:
            self.jobs.remove(job)
        job.w.setParent(None)
        job.w.deleteLater()
        self.refresh_layout_state()

    def on_done(self, job, state):
        w = job.w
        if state == "ok":
            w.bar.setValue(1000)
            w.set_status("Done")
            folder = os.path.dirname(job.dest) if job.dest and not job.playlist else job.outdir
            self.history.insert(0, {"title": job.title, "url": job.url, "folder": folder or job.outdir,
                                    "kind": job.kind, "time": time.strftime("%Y-%m-%d %H:%M")})
            save_history(self.history)
            self.refresh_history()
        elif state == "cancel":
            w.set_status("Cancelled")
        else:
            msg = job.err or "The download failed"
            if "403" in msg:
                msg = "The site refused the download (403). Update the engine from the bar below."
                self.refresh_engine_state()
            w.set_status(msg)
            log_error(f"download failed: {job.url}: {job.err}")
        w.btn.setToolTip("Remove")
        if self.current is job:
            self.current = None
        QTimer.singleShot(0, self.next_job)

    def clear_finished(self):
        for job in list(self.jobs):
            if job.state in ("ok", "fail", "cancel"):
                self.remove_job(job)

    def closeEvent(self, e):
        for pr in [self.probe_proc] + [j.proc for j in self.jobs]:
            try:
                if pr and pr.state() != QProcess.ProcessState.NotRunning:
                    kill_group(pr, signal.SIGTERM)
            except RuntimeError:
                pass
        for j in self.jobs:
            j.cancelled = True
        for pr in [j.proc for j in self.jobs]:
            try:
                if pr and pr.state() != QProcess.ProcessState.NotRunning:
                    if not pr.waitForFinished(1500):
                        kill_group(pr, signal.SIGKILL)
                        pr.waitForFinished(500)
            except RuntimeError:
                pass
        e.accept()


class AppPill(QWidget):
    """Red pill (opens the downloads folder); a small app preview sticks out of its top edge."""
    def __init__(self, main):
        super().__init__()
        self.main = main
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setSizePolicy(QSizePolicy.Policy.Fixed, QSizePolicy.Policy.Fixed)
        self.setFixedSize(px(172), px(32) + 3)
        self._hover = False

    def enterEvent(self, e):
        self._hover = True
        self.update()

    def leaveEvent(self, e):
        self._hover = False
        self.update()

    def mouseReleaseEvent(self, e):
        if e.button() == Qt.MouseButton.LeftButton:
            self.main.open_folder(self.main.dir)

    def paintEvent(self, _e):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        r = QRectF(0.5, 0.5, self.width() - 1, self.height() - 3.5)
        rad = r.height() / 2
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QColor(0, 0, 0, 40))
        p.drawRoundedRect(r.adjusted(0, 1.2, 0, 1.8), rad, rad)
        p.setBrush(red_gradient(r))
        p.setPen(QPen(accent_trio()[2].darker(115), 1))
        p.drawRoundedRect(r, rad, rad)
        hl = QLinearGradient(r.topLeft(), QPointF(r.left(), r.top() + r.height() * 0.55))
        hl.setColorAt(0, QColor(255, 255, 255, 90 if self._hover else 65))
        hl.setColorAt(1, QColor(255, 255, 255, 0))
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(hl)
        p.drawRoundedRect(r.adjusted(1, 1, -1, -1), rad - 1, rad - 1)
        tx = px(14) + px(40) + px(10)
        tw = r.right() - tx - px(8)
        p.setPen(QColor("#ffffff"))
        p.setFont(mkfont(11, QFont.Weight.Bold))
        p.drawText(QRectF(tx, r.top() + px(3), tw, px(15)), Qt.AlignmentFlag.AlignVCenter, "Open Downloads")
        f2 = mkfont(8.5, QFont.Weight.Medium)
        p.setFont(f2)
        p.setPen(QColor(255, 255, 255, 215))
        base = os.path.basename(self.main.dir.rstrip("/")) or self.main.dir
        p.drawText(QRectF(tx, r.top() + px(17), tw, px(12)), Qt.AlignmentFlag.AlignVCenter,
                   QFontMetrics(f2).elidedText("Folder: " + base, Qt.TextElideMode.ElideRight, int(tw)))


