def main():
    global K
    sys.excepthook = excepthook
    maybe_run_newer()
    app = QApplication(sys.argv)
    app.setApplicationName("RedGet")
    app.setApplicationVersion(VERSION)
    app.setDesktopFileName("redget")
    app.setStyle("Fusion")
    STYLE["family"] = pick_family()
    app.setFont(QFont(STYLE["family"]))
    scr = app.primaryScreen().availableGeometry()
    try:
        K = float(os.environ.get("REDGET_SCALE", "0"))
    except ValueError:
        K = 0.0
    if K <= 0:
        K = max(0.95, min(1.3, min(scr.height() * 0.85 / 576.0, scr.width() * 0.85 / 920.0)))
    make_check_png()
    win = Main()
    w, h = min(px(920), scr.width()), min(px(576), scr.height())
    try:
        env = os.environ.get("REDGET_SIZE", "")
        if env:
            w, h = [int(v) for v in env.lower().split("x")]
    except ValueError:
        pass
    win.setMinimumSize(min(px(780), scr.width()), min(px(520), scr.height()))
    win.resize(w, h)
    win.show()
    sys.exit(app.exec())


